# ══════════════════════════════════════════════════════════
# عافيتك — Environment Variables (REQUIRED)
# Copy this file to .env.local and fill in the values
# ══════════════════════════════════════════════════════════

# ─── MongoDB Atlas (REQUIRED) ───
# Get from: MongoDB Atlas > Connect > Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aafiatak?retryWrites=true&w=majority

# ─── Firebase Admin SDK (REQUIRED for push notifications) ───
# Get from: Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=aafiatak-26439
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@aafiatak-26439.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ─── Firebase Client SDK (OPTIONAL - defaults are hardcoded) ───
# These are already hardcoded in src/lib/firebase-client.ts
# Only set these if you want to override the defaults
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
